{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "Kiosk",
		"description": "Custom slides for the Inovus Labs kiosk display",
		"author": "Inovus Labs"
	},
	"settings": {
		"title": "Inovus Labs Kiosk",
		"tagline": "Custom slides for kiosk.inovuslabs.org",
		"timezone": "Asia/Kolkata"
	},
	"collections": [
		{
			"slug": "image_slides",
			"label": "Image slides",
			"labelSingular": "Image slide",
			"description": "Full-screen posters shown before blog posts and podcasts. Publish (or schedule) to put a slide on the kiosk.",
			"icon": "image",
			"group": "Slides",
			"sortOrder": 1,
			"routable": false,
			"supports": ["drafts", "revisions", "scheduling"],
			"titleField": "title",
			"admin": { "listColumns": ["expires_at", "pinned_order"] },
			"fields": [
				{
					"slug": "title",
					"label": "Title (internal label, not shown on screen)",
					"type": "string",
					"required": true,
					"validation": { "maxLength": 120 }
				},
				{
					"slug": "image",
					"label": "Poster image (1080 × 1920 portrait)",
					"type": "image",
					"required": true,
					"validation": {
						"allowedMimeTypes": ["image/jpeg", "image/png", "image/webp", "image/avif"]
					}
				},
				{
					"slug": "expires_at",
					"label": "Expires at (auto-unpublish; leave empty to keep)",
					"type": "datetime",
					"indexed": true
				},
				{
					"slug": "pinned_order",
					"label": "Pinned order (lower = shown first; empty = newest first)",
					"type": "integer",
					"indexed": true
				}
			]
		},
		{
			"slug": "text_slides",
			"label": "Text slides",
			"labelSingular": "Text slide",
			"description": "Billboard announcements shown before blog posts and podcasts. Publish (or schedule) to put a slide on the kiosk.",
			"icon": "text-aa",
			"group": "Slides",
			"sortOrder": 2,
			"routable": false,
			"supports": ["drafts", "revisions", "scheduling"],
			"titleField": "title",
			"admin": { "listColumns": ["theme", "expires_at", "pinned_order"] },
			"fields": [
				{
					"slug": "title",
					"label": "Headline",
					"type": "string",
					"required": true,
					"validation": { "maxLength": 120 }
				},
				{
					"slug": "body",
					"label": "Body",
					"type": "text",
					"validation": { "maxLength": 400 }
				},
				{
					"slug": "theme",
					"label": "Theme (Midnight if left empty)",
					"type": "select",
					"validation": { "options": ["midnight", "slate", "emerald", "bordeaux"] }
				},
				{
					"slug": "expires_at",
					"label": "Expires at (auto-unpublish; leave empty to keep)",
					"type": "datetime",
					"indexed": true
				},
				{
					"slug": "pinned_order",
					"label": "Pinned order (lower = shown first; empty = newest first)",
					"type": "integer",
					"indexed": true
				}
			]
		}
	]
}
