{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kiosk-worker",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB", "database_name": "kiosk-db", "database_id": "2d0cac8b-b502-4457-a838-decaa66d731e" },
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "kiosk-media" }],
  // Astro sessions (EmDash admin sign-in).
  "kv_namespaces": [{ "binding": "SESSION", "id": "2ce342b1c4594c95b83ad9b688977343" }],
  // Every minute: EmDash scheduled publishing.
  "triggers": { "crons": ["* * * * *"] },
  "observability": {
    "logs": { "enabled": true, "invocation_logs": true },
  },
  // Secrets via `wrangler secret put`: EMDASH_ENCRYPTION_KEY
}
