{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kiosk-worker",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "kiosk-cms.inovuslabs.org", "custom_domain": true }],
  "d1_databases": [
    { "binding": "DB", "database_name": "kiosk-db", "database_id": "2d0cac8b-b502-4457-a838-decaa66d731e" },
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "kiosk-media" }],
  // Astro sessions (EmDash admin sign-in).
  "kv_namespaces": [{ "binding": "SESSION", "id": "2ce342b1c4594c95b83ad9b688977343" }],
  // Every minute: EmDash scheduled publishing + the slide-expiry sweep in src/worker.ts.
  "triggers": { "crons": ["* * * * *"] },
  "observability": {
    "logs": { "enabled": true, "invocation_logs": true },
  },
  "vars": {
    "GITHUB_REPO": "inovus-labs/kiosk.inovuslabs.org",
    "GHOST_DISPATCH_EVENT_TYPE": "ghost-publish",
    "CMS_DISPATCH_EVENT_TYPE": "cms-publish",
  },
  // Secrets via `wrangler secret put`: EMDASH_ENCRYPTION_KEY, WEBHOOK_SECRET, GH_TOKEN
}
