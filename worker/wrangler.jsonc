{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kiosk-worker",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "kiosk-cms.inovuslabs.org", "custom_domain": true },
    // Ghost social web (ActivityPub) paths, proxied by src/lib/activitypub.ts.
    { "pattern": "blog.inovuslabs.org/.ghost/activitypub/*", "zone_name": "inovuslabs.org" },
    { "pattern": "blog.inovuslabs.org/.well-known/webfinger*", "zone_name": "inovuslabs.org" },
    { "pattern": "blog.inovuslabs.org/.well-known/nodeinfo*", "zone_name": "inovuslabs.org" },
    // Every other blog page, for its Standard.site <link> tags (src/lib/blog-pages.ts). Asset, admin and member
    // paths have Worker-less routes in the dashboard, so they go straight to Ghost.
    { "pattern": "blog.inovuslabs.org/*", "zone_name": "inovuslabs.org" },
    // Blog's social web handle domain (@blog@inovuslabs.org), redirected to the blog.
    { "pattern": "inovuslabs.org/.well-known/webfinger*", "zone_name": "inovuslabs.org" },
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "kiosk-db", "database_id": "2d0cac8b-b502-4457-a838-decaa66d731e" },
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "kiosk-media" }],
  "kv_namespaces": [
    // Astro sessions (EmDash admin sign-in).
    { "binding": "SESSION", "id": "2ce342b1c4594c95b83ad9b688977343" },
    // Bluesky session tokens and Ghost post id -> Bluesky post URI (src/lib/bluesky.ts).
    { "binding": "BLUESKY", "id": "3119483a09634a5695ba0c643563f778" },
  ],
  // Inovus's own PDS (pds.inovuslabs.org), reached directly rather than over the public internet.
  "services": [{ "binding": "PDS", "service": "pds-inovuslabs" }],
  // Astro adds this binding anyway; src/lib/bluesky.ts also uses it to shrink cover images for Bluesky.
  "images": { "binding": "IMAGES" },
  // Every minute: EmDash scheduled publishing + the slide-expiry sweep in src/worker.ts.
  "triggers": { "crons": ["* * * * *"] },
  "observability": {
    "logs": { "enabled": true, "invocation_logs": true },
  },
  "vars": {
    // Public origin for passkeys, CSRF and setup. Local dev overrides it in .env.
    "EMDASH_SITE_URL": "https://kiosk-cms.inovuslabs.org",
    "GITHUB_REPO": "inovus-labs/kiosk.inovuslabs.org",
    "GHOST_DISPATCH_EVENT_TYPE": "ghost-publish",
    "CMS_DISPATCH_EVENT_TYPE": "cms-publish",
    "GHOST_BLOG_HOST": "blog.inovuslabs.org",
    "ACTIVITYPUB_TARGET": "https://ap.ghost.org",
    "SOCIAL_WEB_DOMAIN": "inovuslabs.org",
    // New Ghost posts are posted to Bluesky as this account; "true" only logs what would be posted.
    "BLUESKY_HANDLE": "inovuslabs.org",
    "BLUESKY_DRY_RUN": "true",
  },
  // Secrets via `wrangler secret put`: EMDASH_ENCRYPTION_KEY, WEBHOOK_SECRET, GH_TOKEN, BLUESKY_APP_PASSWORD
}
