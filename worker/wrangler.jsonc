{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kiosk-worker",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "kiosk-cms.inovuslabs.org", "custom_domain": true },
    { "pattern": "blog.inovuslabs.org/.ghost/activitypub/*", "zone_name": "inovuslabs.org" },
    { "pattern": "blog.inovuslabs.org/.well-known/webfinger*", "zone_name": "inovuslabs.org" },
    { "pattern": "blog.inovuslabs.org/.well-known/nodeinfo*", "zone_name": "inovuslabs.org" },
    // Blog assets, /ghost and /members have Worker-less routes in the dashboard.
    { "pattern": "blog.inovuslabs.org/*", "zone_name": "inovuslabs.org" },
    { "pattern": "inovuslabs.org/.well-known/webfinger*", "zone_name": "inovuslabs.org" },
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "kiosk-db", "database_id": "2d0cac8b-b502-4457-a838-decaa66d731e" },
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "kiosk-media" }],
  "kv_namespaces": [
    { "binding": "SESSION", "id": "2ce342b1c4594c95b83ad9b688977343" },
    { "binding": "BLUESKY", "id": "3119483a09634a5695ba0c643563f778" },
    { "binding": "LINKEDIN", "id": "9a853c9e4ebd4942a509faeebb300bb9" },
  ],
  "services": [{ "binding": "PDS", "service": "pds-inovuslabs" }],
  // Also used by Astro's image service, which adds it anyway.
  "images": { "binding": "IMAGES" },
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["* * * * *"] },
  "observability": {
    "logs": { "enabled": true, "invocation_logs": true },
  },
  "vars": {
    "EMDASH_SITE_URL": "https://kiosk-cms.inovuslabs.org",
    "GITHUB_REPO": "inovus-labs/kiosk.inovuslabs.org",
    "GHOST_DISPATCH_EVENT_TYPE": "ghost-publish",
    "CMS_DISPATCH_EVENT_TYPE": "cms-publish",
    "GHOST_BLOG_HOST": "blog.inovuslabs.org",
    "ACTIVITYPUB_TARGET": "https://ap.ghost.org",
    "SOCIAL_WEB_DOMAIN": "inovuslabs.org",
    "BLUESKY_HANDLE": "inovuslabs.org",
    "BLUESKY_DRY_RUN": "false",
    "LINKEDIN_CLIENT_ID": "77h8m4x2e39agl",
    "LINKEDIN_ORGANIZATION": "14411152",
    "LINKEDIN_DRY_RUN": "true",
  },
  // Secrets: EMDASH_ENCRYPTION_KEY, WEBHOOK_SECRET, GH_TOKEN, BLUESKY_APP_PASSWORD, LINKEDIN_CLIENT_SECRET
}
